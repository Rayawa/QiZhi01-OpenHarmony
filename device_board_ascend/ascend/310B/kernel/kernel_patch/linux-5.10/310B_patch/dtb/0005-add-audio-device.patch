---
 .../hi1910BL/product/hi1910B-audio.dtsi       | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/dtb/dts/hi1910b/hi1910BL/product/hi1910B-audio.dtsi b/dtb/dts/hi1910b/hi1910BL/product/hi1910B-audio.dtsi
index 496d0dd..86f62a5 100644
--- a/dtb/dts/hi1910b/hi1910BL/product/hi1910B-audio.dtsi
+++ b/dtb/dts/hi1910b/hi1910BL/product/hi1910B-audio.dtsi
@@ -20,3 +20,23 @@ audio: audio {
 audio-sys {
         compatible = "hisilicon,hisi-audio-sys";
 };
+
+sound {
+	compatible = "Ascend,310b-audio-machine";
+	ascend310b,platform = <&ascend310b_platform>;
+	audio-routing =
+		"Headphone", "HP_L",
+		"Headphone", "HP_R",
+		"LINPUT1", "AMIC",
+		"RINPUT1", "AMIC";
+	ascend310b,audio-codec = <&ascend310b_codec>;
+};
+
+ascend310b_codec: ascend310b_codec {
+	compatible = "Ascend,310b-audio-codec";
+};
+
+ascend310b_platform: ascend310b_platform {
+	compatible = "Ascend,310b-audio-platform";
+	ascend310b,audio = <&audio>;
+};
