import("//build/ohos.gni")
import("device.gni")

print("310B_group in")
group("310B_group") {
  deps = [
    "cfg:init_configs",
    "kernel:kernel",
    "kernel:kernel_driver",
    "updater:updater_files",
    "//device/soc/ascend/310B/hardware:hardware_group",
    "ascendinstall:ascendinstall",
    "//device/board/ascend/310B/audio_alsa:audio",
  ]
   if (is_support_graphic) {
    deps += [
      "//device/soc/ascend/310B/hardware/display:display_buffer_model",
      "//device/soc/ascend/310B/hardware/display:display_composer_model",
    ]
  }

  if (is_support_boot_animation) {
    deps += [ "bootanimation:bootanimation" ]
  }
}
