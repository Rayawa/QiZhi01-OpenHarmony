import("//build/ohos.gni")
import("//device/board/${product_company}/${device_name}/device.gni")

ohos_prebuilt_etc("music_hap") {
  source = "//device/board/${product_company}/${device_name}/audio_alsa/hap/Music_Demo.hap"
  part_name = "device_310B"
  install_enable = true
}

ohos_prebuilt_etc("tianlu_wav") {
  source = "//device/board/${product_company}/${device_name}/audio_alsa/hap/tianlu.wav"
  part_name = "device_310B"
  install_enable = true
}

group("audio_hap") {
  deps = [
    ":music_hap",
    ":tianlu_wav",
  ]
}






