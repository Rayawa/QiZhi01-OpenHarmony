Subject: [PATCH] add_videodev_permission

---
 ueventd/etc/ueventd.config | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ueventd/etc/ueventd.config b/ueventd/etc/ueventd.config
index e7d1bf77..0fbf84b5 100644
--- a/ueventd/etc/ueventd.config
+++ b/ueventd/etc/ueventd.config
@@ -77,7 +77,7 @@
 /dev/ttyS* 0666 0 0
 /dev/ttyACM* 0666 0 0
 /dev/ttyUSB* 0666 0 0
-/dev/video* 0660 camera_host camera_host
+/dev/video* 0777 0 0
 /dev/btdev* 0660 dsoftbus dsoftbus
 /dev/block/by-name/misc 0660 update update
 /dev/block/by-name/bootctrl 0660 update update
