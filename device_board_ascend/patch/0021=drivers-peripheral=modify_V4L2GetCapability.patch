From 90ccd4fd79e82941d2720d6efc57a4f8ae4813e1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E6=9C=B1=E6=B4=AA=E7=91=9E?= <zhuhongrui8@huawei.com>
Date: Fri, 28 Mar 2025 10:32:01 +0800
Subject: [PATCH] modify_V4L2GetCapability

---
 .../src/driver_adapter/src/v4l2_fileformat.cpp  | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/camera/vdi_base/common/adapter/platform/v4l2/src/driver_adapter/src/v4l2_fileformat.cpp b/camera/vdi_base/common/adapter/platform/v4l2/src/driver_adapter/src/v4l2_fileformat.cpp
index f32b0942e..3adb1b277 100644
--- a/camera/vdi_base/common/adapter/platform/v4l2/src/driver_adapter/src/v4l2_fileformat.cpp
+++ b/camera/vdi_base/common/adapter/platform/v4l2/src/driver_adapter/src/v4l2_fileformat.cpp
@@ -138,13 +138,16 @@ RetCode HosFileFormat::V4L2GetCapability(int fd, const std::string& devName, con
     }
 
     std::lock_guard<std::mutex> l(HosV4L2Dev::deviceFdLock_);
-    HosV4L2Dev::deviceMatch.insert(std::make_pair(std::string(reinterpret_cast<char*>(cap.driver)), devName));
-
-    CAMERA_LOGI("v4l2 driver name = %{public}s\n", cap.driver);
-    CAMERA_LOGD("v4l2 capabilities = 0x%{public}x\n", cap.capabilities);
-    CAMERA_LOGD("v4l2 card: %{public}s\n", cap.card);
-    CAMERA_LOGD("v4l2 bus info: %{public}s\n", cap.bus_info);
-
+    std::string tmp("uvcvideo");
+    std::string src = std::string(reinterpret_cast<char*>(cap.driver));
+    if (src.compare(0, tmp.length(), tmp) != 0) {
+        HosV4L2Dev::deviceMatch.insert(std::make_pair(std::string(reinterpret_cast<char*>(cap.driver)), devName));
+
+        CAMERA_LOGI("v4l2 driver name = %{public}s\n", cap.driver);
+        CAMERA_LOGD("v4l2 capabilities = 0x%{public}x\n", cap.capabilities);
+        CAMERA_LOGD("v4l2 card: %{public}s\n", cap.card);
+        CAMERA_LOGD("v4l2 bus info: %{public}s\n", cap.bus_info);
+    }
     return RC_OK;
 }
 
-- 
