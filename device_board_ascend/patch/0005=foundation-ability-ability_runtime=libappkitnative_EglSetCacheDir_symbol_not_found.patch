From 8b57e7b7fa26444ac51fae865bf1139e8fa9c7c6 Mon Sep 17 00:00:00 2001
From: zhaoxin <zhaoxin214@huawei.com>
Date: Wed, 26 Mar 2025 11:21:01 +0800
Subject: [PATCH] libappkit_native EglSetCacheDir error

---
 frameworks/native/appkit/BUILD.gn            |  3 ++
 frameworks/native/appkit/app/main_thread.cpp | 45 ++++++++++++++++++++
 2 files changed, 48 insertions(+)

diff --git a/frameworks/native/appkit/BUILD.gn b/frameworks/native/appkit/BUILD.gn
index cf6de55e1c..a4f93aed2c 100644
--- a/frameworks/native/appkit/BUILD.gn
+++ b/frameworks/native/appkit/BUILD.gn
@@ -146,6 +146,9 @@ ohos_shared_library("appkit_native") {
   if (target_cpu == "arm") {
     cflags += [ "-DBINDER_IPC_32BIT" ]
   }
+  if (product_name == "310B") {
+    cflags += [ "-DOHOS_MESA3D" ]
+  }
   deps = [
     ":appkit_delegator",
     "${ability_runtime_abilitymgr_path}/:abilityms",
diff --git a/frameworks/native/appkit/app/main_thread.cpp b/frameworks/native/appkit/app/main_thread.cpp
index b98c13f414..fb07f69297 100644
--- a/frameworks/native/appkit/app/main_thread.cpp
+++ b/frameworks/native/appkit/app/main_thread.cpp
@@ -179,6 +179,47 @@ constexpr int32_t PRELOAD_TASK_DELAY_TIME = 2000;  //millisecond
 #endif
 
 extern "C" int DFX_SetAppRunningUniqueId(const char* appRunningId, size_t len) __attribute__((weak));
+
+#ifdef OHOS_MESA3D
+static bool initStatus;
+static std::string cacheDir;
+static std::string ddkcacheDir;
+
+void SetCacheDir(const std::string dir)
+{
+    struct stat dirStat;
+    if (stat(dir.c_str(), &dirStat) != 0) {
+        TAG_LOGI(AAFwkTag::APPKIT, "inputdir not Create");
+        initStatus = false;
+        return;
+    }
+
+    struct stat cachedirstat;
+    struct stat ddkdirstat;
+    cacheDir = dir + std::string("/blobShader");
+    ddkcacheDir = dir + std::string("/ddkShader");
+
+    if (stat(cacheDir.c_str(), &cachedirstat) != 0) {
+        initStatus = false;
+        int ret = mkdir(cacheDir.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH);
+        if (ret == -1) {
+            initStatus = false;
+            TAG_LOGI(AAFwkTag::APPKIT, "cacheDir not Create");
+        } else {
+            initStatus = true;
+        }
+    } else {
+        initStatus = true;
+    }
+
+    if (stat(ddkcacheDir.c_str(), &ddkdirstat) != 0) {
+        int ret = mkdir(ddkcacheDir.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH);
+        if (ret == -1 && errno != EEXIST) {
+           TAG_LOGI(AAFwkTag::APPKIT, "ddkcacheDir not Create");
+        }
+    }
+}
+#endif
 } // namespace
 
 void MainThread::GetNativeLibPath(const BundleInfo &bundleInfo, const HspList &hspList, AppLibPathMap &appLibPaths)
@@ -1425,7 +1466,11 @@ void MainThread::HandleLaunchApplication(const AppLaunchData &appLaunchData, con
     application_->SetApplicationContext(applicationContext);
 
 #ifdef SUPPORT_GRAPHICS
+#ifdef OHOS_MESA3D
+    SetCacheDir(applicationContext->GetCacheDir());
+#else
     OHOS::EglSetCacheDir(applicationContext->GetCacheDir());
+#endif
 #endif
 
     HspList hspList;
-- 
2.47.1.windows.1

